# Plantilla de entorno para el stack Docker
# Copia este fichero a .env.docker y rellena los valores reales:
#     cp .env.docker.example .env.docker

# --- Contenedor PostgreSQL
POSTGRES_DB=blablaUCM
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- Base de datos vista desde Django ---
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=blablaUCM
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
# Segundos que se reutiliza una conexion. 0 = una conexion nueva por peticion
DB_CONN_MAX_AGE=0
# Cifrado de la conexion
DB_SSLMODE=
# Plantilla desde la que Django clona la BBDD de test (trae PostGIS instalado)
DB_TEST_TEMPLATE=template_postgis

# --- Arranque del contenedor (las lee docker-entrypoint.sh) ---
# Esperar a que la BBDD acepte conexiones antes de migrar
WAIT_FOR_DB=true
# Segundos maximos de espera antes de abortar el arranque
WAIT_FOR_DB_TIMEOUT=60
# La imagen postgis/postgis ya crea la extension al inicializar el volumen, asique no hace falta
CREATE_POSTGIS_EXTENSION=false

# --- Django ---
SECRET_KEY=genera-una-clave-larga-y-aleatoria
DEBUG=False
# Ajusta a tu dominio en produccion (p.ej. api.tudominio.com,localhost)
ALLOWED_HOSTS=*
# Dominios de correo con los que se puede crear cuenta o cambiar el correo de una ya existente
ALLOWED_DOMAINS=*
MEDIA_PATH=media
LOGS_PATH=/app/logs
LOGS_NAME=BlaBlaUCM
# Registros: se rotan por tamaño, con tope de LOG_MAX_BYTES * (LOG_BACKUP_COUNT + 1)
# LOG_LEVEL=DEBUG
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=10

# --- CORS / CSRF ---
CORS_ALLOW_ALL_ORIGINS=True
# Solo se tiene en cuenta cuando CORS_ALLOW_ALL_ORIGINS=False.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
# Origenes en los que Django se fia de la cookie CSRF
CSRF_TRUSTED_ORIGINS=

# --- Limitacion de peticiones ---
# False desactiva TODOS los limites de golpe (los tests lo usan).
THROTTLE_ENABLED=True
# Cuantos proxies hay por delante
NUM_PROXIES=1
THROTTLE_VERIFICATION_EMAIL=5/hour
THROTTLE_VERIFY_CODE=10/hour
# Segundo factor
THROTTLE_TWO_FACTOR=10/hour
THROTTLE_USER_LOOKUP=30/hour
THROTTLE_LOGIN=10/minute
THROTTLE_VALIDATION_CODE=20/minute
# Acceso con proveedor externo
THROTTLE_OAUTH_LOGIN=20/minute
# Alta con usuario y contrasena
THROTTLE_REGISTER=10/hour
# Renovacion del token
THROTTLE_TOKEN_REFRESH=60/hour

# --- JWT (opcionales, con defaults en settings.py) ---
ACCESS_TOKEN_LIFETIME=5
REFRESH_TOKEN_LIFETIME=7
SLIDING_TOKEN_LIFETIME=5
SLIDING_TOKEN_REFRESH_LIFETIME=7
# Minutos que vale el codigo de verificacion enviado por correo
TOKEN_EXPIRATION_TIME=5

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-cuenta@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password
# Segundos de espera maxima al hablar con el servidor de correo
EMAIL_TIMEOUT=10

# --- Google OAuth ---
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_DEFAULT_USER_TYPE=std

# --- Firebase Cloud Messaging (opcional) ---
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase.json

# --- Channels / WebSockets ---
REDIS_URL=

# --- HTTPS
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --- Panel de administracion y señuelo ---
# En /admin/ queda un señuelo que registra y avisa por correo
ADMIN_URL=panel-interno/

# Avisos del señuelo. Vacio => no se manda correo
HONEYPOT_NOTIFY_EMAIL=
HONEYPOT_EMAIL_COOLDOWN=3600
HONEYPOT_MAX_EMAILS_HOUR=20
HONEYPOT_NOTIFY_ON_GET=False