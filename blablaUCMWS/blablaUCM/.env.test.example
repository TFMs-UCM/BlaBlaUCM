# Plantilla de entorno para laspruebas
# docker-compose.test.yml (Postgres+PostGIS en localhost:5433)
#
#     cp .env.test.example .env.test    # y ajustar la ruta de OSGeo4W
#     docker compose -f docker-compose.test.yml up -d
#     .\scripts\run_tests.ps1

# --- BBDD de test (contenedor db-test, puerto 5433) ---
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=blablaucm_test
DB_USER=test
DB_PASSWORD=test
DB_HOST=localhost
DB_PORT=5433
# Django clona la BBDD de test
DB_TEST_TEMPLATE=template_postgis
# Conexion nueva por peticion: entre test y test Django cierra las conexiones,
# reutilizarlas aqui no aporta nada.
DB_CONN_MAX_AGE=0
# La BBDD de test es un contenedor local, sin TLS.
DB_SSLMODE=

# --- Django ---
SECRET_KEY=clave-solo-para-tests
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Dominios de correo admitidos (* para todos)
ALLOWED_DOMAINS=*
MEDIA_PATH=media
LOGS_PATH=logs
LOGS_NAME=BlaBlaUCM_test

# --- Registros ---
# En los tests interesa el detalle: si algo falla, el log es lo unico que queda.
LOG_LEVEL=DEBUG
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# --- Email / Google / Firebase: se mockean en los tests
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=test@example.com
EMAIL_HOST_PASSWORD=dummy
# Con locmem no se abre ninguna conexion, el timeout no llega a usarse.
EMAIL_TIMEOUT=10
GOOGLE_CLIENT_ID=dummy-client-id
GOOGLE_DEFAULT_USER_TYPE=std
FIREBASE_CREDENTIALS_PATH=/tmp/firebase-dummy.json

# --- Channels
REDIS_URL=

# --- CORS / CSRF ---
# El cliente de test no pasa por el middleware de CORS, esto no afecta a la suite
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=

# --- HTTPS: los tests van por http, todo desactivado
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --- GDAL/GEOS en el host Windows
OSGEO4W_DIR=C:\Users\User\AppData\Local\Programs\OSGeo4W
GDAL_DLL=bin\gdal312.dll
GEOS_DLL=bin\geos_c.dll

# --- Limitacion de peticiones
# Las pruebas encadenan peticiones a proposito 
THROTTLE_ENABLED=False
NUM_PROXIES=1
# THROTTLE_VERIFICATION_EMAIL=5/hour
# THROTTLE_VERIFY_CODE=10/hour
# THROTTLE_TWO_FACTOR=10/hour
# THROTTLE_USER_LOOKUP=30/hour
# THROTTLE_LOGIN=10/minute
# THROTTLE_VALIDATION_CODE=20/minute
# THROTTLE_OAUTH_LOGIN=20/minute
# THROTTLE_REGISTER=10/hour
# THROTTLE_TOKEN_REFRESH=60/hour

# --- JWT ---
# Los valores por defecto de settings.py, que son los que usa la CI
ACCESS_TOKEN_LIFETIME=1
REFRESH_TOKEN_LIFETIME=7
SLIDING_TOKEN_LIFETIME=5
SLIDING_TOKEN_REFRESH_LIFETIME=7
# Minutos que vale el codigo de verificacion enviado por correo
TOKEN_EXPIRATION_TIME=5

# --- Panel de administracion y señuelo
ADMIN_URL=panel-interno/
HONEYPOT_NOTIFY_EMAIL=
# Segundos que espera el señuelo antes de volver a avisar de la misma IP
HONEYPOT_EMAIL_COOLDOWN=3600
HONEYPOT_MAX_EMAILS_HOUR=20
# A False solo se avisa de los intentos de acceso (POST). A True tambien de las visitas (GET)
HONEYPOT_NOTIFY_ON_GET=False

# --- Volcado de resultados de las pruebas
TEST_OUTPUT_DIR=test-results
TEST_OUTPUT_FILE_NAME=junit.xml
TEST_OUTPUT_VERBOSE=1