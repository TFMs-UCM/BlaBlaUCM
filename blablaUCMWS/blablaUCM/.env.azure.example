# Plantilla de entorno para el despliegue en Azure (docker-compose.azure.yml).
#     cp .env.azure.example .env.azure     # y rellenar los valores reales
#     scripts/azure.sh up -d --build

# Dominio y certificado
DOMAIN=blablaucm.app
# Correo al que Let's Encrypt avisa si un certificado no consigue renovarse
ACME_EMAIL=tu-correo@ejemplo.com
# Carpeta de la maquina con la landing publica (index.html, icono, .apk)
WEB_ROOT=/home/azureuser/pag_web

# --- Base de datos
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=blablaucm
DB_USER=usuario
DB_PASSWORD=pon-aqui-la-contrasena-del-servidor
DB_HOST=host-de-la-bbdd.postgres.database.azure.com
DB_PORT=5432
# Azure rechaza las conexiones sin cifrar.
DB_SSLMODE=require
# Reutiliza la conexion 60s
DB_CONN_MAX_AGE=60

# Arranque del contenedor
WAIT_FOR_DB=true
WAIT_FOR_DB_TIMEOUT=60
# Crea la extension PostGIS si falta
CREATE_POSTGIS_EXTENSION=true

# --- Django ---
SECRET_KEY=genera-una-clave-nueva
DEBUG=False
ALLOWED_HOSTS=hosts
# Dominios de correo con los que se puede crear cuenta o cambiar el correo de una ya existente
ALLOWED_DOMAINS=domains
# Con esquema https://, obligatorio para que funcione el panel /admin/ detras del proxy.
CSRF_TRUSTED_ORIGINS=domains
MEDIA_PATH=media

# --- Registros ---
LOGS_PATH=/app/logs
LOGS_NAME=BlaBlaUCM
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# --- CORS ---
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=origins

# --- Limitacion de peticiones ---
NUM_PROXIES=1
THROTTLE_VERIFICATION_EMAIL=5/hour
THROTTLE_VERIFY_CODE=10/hour
# Segundo factor
THROTTLE_TWO_FACTOR=10/hour
THROTTLE_USER_LOOKUP=30/hour
THROTTLE_LOGIN=10/minute
THROTTLE_VALIDATION_CODE=20/minute
# Acceso con proveedor externo
THROTTLE_OAUTH_LOGIN=20/minute
# Alta con usuario y contrasena
THROTTLE_REGISTER=10/hour
# Renovacion del token
THROTTLE_TOKEN_REFRESH=60/hour

# --- JWT ---
ACCESS_TOKEN_LIFETIME=5
REFRESH_TOKEN_LIFETIME=7
SLIDING_TOKEN_LIFETIME=5
SLIDING_TOKEN_REFRESH_LIFETIME=7
TOKEN_EXPIRATION_TIME=5

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-cuenta@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password
# Segundos de espera maxima al hablar con el servidor de correo
EMAIL_TIMEOUT=10

# --- Google OAuth ---
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_DEFAULT_USER_TYPE=std

# --- Firebase Cloud Messaging ---
# Copia el JSON a ./secrets/firebase.json en la VM.
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase.json

# --- Channels / WebSockets + cache ---
# redis es el nombre del servicio en docker-compose.azure.yml.
REDIS_URL=redis://redis:6379/0

# --- HTTPS (Caddy termina el TLS por delante) ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# --- Panel de administracion y señuelo ---
# En /admin/ queda un señuelo que registra y avisa por correo 
ADMIN_URL=panel-interno/

# A donde llegan los avisos del señuelo, Si esta vacio, no se manda correo
HONEYPOT_NOTIFY_EMAIL=
# Un aviso por IP cada 
HONEYPOT_EMAIL_COOLDOWN=3600
# Tope global de avisos por hora
HONEYPOT_MAX_EMAILS_HOUR=20
# True avisa tambien de las simples visitas (GET)
HONEYPOT_NOTIFY_ON_GET=False
